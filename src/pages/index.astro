---
import "../styles/global.css";
import Header from "../components/Header.astro";

const resort01 = "/images/avista/resort-01.jpg";
const resort02 = "/images/avista/resort-02.jpg";
const resort03 = "/images/avista/resort-03.jpg";
const resort04 = "/images/avista/resort-04.jpg";
const garden01 = "/images/avista/garden-01.webp";
const garden02 = "/images/avista/garden-02.webp";
const garden03 = "/images/avista/garden-03.webp";
const cypress01 = "/images/avista/cypress-01.webp";

const heroImage = resort01;
const aboutImages = [garden03, cypress01];
const stayImage = resort02;
const ctaImage = resort01;

const rooms = [
  {
    name: "Avista Private Resort",
    meta: "The flagship · Contemporary stone",
    description:
      "Set in its own clearing of 2,500 square metres. Stone walls, a long pergola, a pool with a quiet waterfall, and a view toward the distant Aegean.",
    image: resort01,
    href: "/villas/avista-private-resort",
  },
  {
    name: "Avista Villa",
    meta: "The sister · Traditional Greek · With pool",
    description:
      "Double-height ceilings, terracotta floors, wicker and dark wood. A private pool wrapped in olive trees, lit beautifully for the evenings.",
    image: garden03,
    href: "/villas/avista-villa",
  },
  {
    name: "Avista Superb Villa",
    meta: "The sister · Traditional Greek · No pool",
    description:
      "Same warm Greek architecture, same garden quality. Without a private pool — a shorter walk to the beach instead.",
    image: cypress01,
    href: "/villas/avista-superb-villa",
  },
];

const galleryImages = [
  resort02,
  garden03,
  resort04,
  garden01,
  resort03,
  cypress01,
];

const testimonials = [
  {
    quote:
      "The kind of holiday we forgot existed. The garden, the cicadas, and a phone number that always answered when we needed something. We're already planning to come back.",
    name: "Sophie",
    role: "July 2025",
  },
  {
    quote:
      "We've stayed in many villas in Greece. The Private Resort at Avista is the only one that felt like an actual home, not a rental. The team thought of every detail without being intrusive.",
    name: "Marcus",
    role: "August 2024",
  },
  {
    quote:
      "My children were barefoot for a week. They ate tomatoes from the garden. They didn't ask for the iPad once. That should tell you everything you need to know about this place.",
    name: "Camille",
    role: "June 2025",
  },
];

const stories = [
  {
    title: "The eight beaches of Sithonia, ranked honestly",
    date: "April 2026 · Sithonia Guide",
    image: resort02,
    excerpt:
      "Kavourotrypes is the famous one — and it earns the reputation, but only before mid-July. Here is how we think about the rest.",
  },
  {
    title: "Where we actually eat in Sithonia",
    date: "March 2026 · Sithonia Guide",
    image: garden01,
    excerpt:
      "Five tavernas worth the drive — from the seafood shack in Sárti to the family taverna up the hill in Neos Marmaras.",
  },
  {
    title: "Why September is the best month to come",
    date: "February 2026 · Sithonia Guide",
    image: cypress01,
    excerpt:
      "The sea is still warm, the crowds have gone, the figs are at their best. A quiet case for shoulder-season Sithonia.",
  },
];

const sithoniaCards = [
  {
    image: resort02,
    eyebrow: "Beaches",
    title: "Our top eight, ranked honestly",
    note: "Including the three our guests rarely find without us.",
  },
  {
    image: garden02,
    eyebrow: "Tavernas",
    title: "Five worth the drive",
    note: "With approximate prices, what to order, and whether to book.",
  },
  {
    image: cypress01,
    eyebrow: "The Map",
    title: "Hand-drawn, given to every guest",
    note: "Beaches, tavernas, the baker, the back roads everyone misses.",
  },
];

const section = "px-3 py-20 tablet:px-5 tablet:py-24 desktop:py-32";
const container = "mx-auto w-full max-w-[1600px]";

const label =
  "font-sans text-[11px] font-medium uppercase tracking-[0.3em] text-stone";
const labelDark =
  "font-sans text-[11px] font-medium uppercase tracking-[0.3em] text-stone-deep";

const heading = "font-display font-light leading-[0.95] text-cream";
const headingDark = "font-display font-light leading-[0.95] text-ink";
const headingHero = "font-display font-light leading-[0.85] text-cream";

const button =
  "inline-flex items-center justify-center border border-stone/55 px-7 py-4 font-display text-[18px] font-normal italic leading-none text-cream transition hover:bg-stone hover:border-stone hover:text-charcoal";
const buttonDark =
  "inline-flex items-center justify-center border border-charcoal/30 px-7 py-4 font-display text-[18px] font-normal italic leading-none text-charcoal transition hover:bg-charcoal hover:text-cream";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Avista Villas is a small family collection of three private villas in the pines of Sithonia, Halkidiki. Quiet, private, and family-run."
    />
    <meta name="theme-color" content="#2B2A27" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>Avista Villas - Three private villas in Sithonia</title>
  </head>
  <body class="bg-charcoal text-cream">
    <Header homeHref="#hero" contactHref="#contact" />

    <div id="smooth-wrapper">
      <main id="smooth-content" class="overflow-hidden">
      <section
        id="hero"
        class="overflow-hidden relative min-h-screen bg-charcoal"
      >
        <img
          src={heroImage}
          alt="Stone villa atmosphere with warm natural light"
          class="absolute inset-0 h-full w-full scale-105 object-cover"
          loading="eager"
          decoding="async"
        />
        <div class="noise-layer"></div>
        <div
          class="absolute inset-0 bg-gradient-to-b from-charcoal/55 via-charcoal/30 to-ink/65"
        >
        </div>
        <div class="cover-glow"></div>
        <div
          class="absolute inset-x-3 bottom-0 top-0 border-x border-stone/30 tablet:inset-x-5 desktop:left-[calc((100vw-1600px)/2)] desktop:right-[calc((100vw-1600px)/2)]"
        >
          <div
            class="hidden h-full border-x border-stone/20 desktop:mx-[33.33%] desktop:block"
          >
          </div>
        </div>
        <div
          class={`${container} relative flex min-h-screen flex-col items-center justify-center px-6 text-center`}
        >
          <p
            class="mb-2 font-sans text-[10px] font-medium uppercase tracking-[0.4em] text-stone tablet:mb-4 tablet:text-[11px]"
          >
            A small family collection · Sithonia · Greece
          </p>
          <h1
            class={`${headingHero} script-mark`}
            style="font-size: clamp(5rem, 13vw, 11rem); line-height: 0.95;"
          >
            Avista
          </h1>
          <p
            class="mt-3 font-sans text-[12px] font-medium uppercase tracking-[0.6em] text-cream tablet:text-[13px]"
          >
            <span class="ml-[0.6em]">Villas</span>
          </p>
          <span
            class="my-8 inline-block h-px w-16 bg-stone tablet:my-10"
            aria-hidden="true"></span>
          <p
            class="max-w-[520px] text-center font-display italic text-[20px] font-light leading-[1.4] text-cream/85 tablet:text-[24px]"
          >
            Three quiet houses in the pines, kept by us for families who want
            Greece on their own terms.
          </p>
          <a
            href="#about"
            class="absolute bottom-8 left-1/2 flex -translate-x-1/2 flex-col items-center gap-4 font-sans text-[10px] font-medium uppercase tracking-[0.3em] text-stone"
          >
            Scroll
            <span class="h-24 w-px bg-stone"></span>
          </a>
        </div>
      </section>

      <section id="about" class={`${section} bg-bone text-charcoal`}>
        <div class={`${container}`}>
          <div class="flex flex-col items-center gap-6 text-center">
            <p class={labelDark}>About</p>
            <h2
              class={headingDark}
              style="font-size: clamp(2.5rem, 5vw, 3.625rem);"
            >
              A small <em class="font-light italic text-stone-deep"
                >family collection</em
              >
            </h2>
            <span
              class="mt-2 inline-block h-px w-12 bg-stone-deep/60"
              aria-hidden="true"></span>
          </div>
          <div
            class="mt-12 grid grid-cols-2 gap-3 tablet:mt-16 tablet:gap-5 max-w-4xl mx-auto"
          >
            {
              aboutImages.map((image, index) => (
                <figure class="overflow-hidden">
                  <div class="aspect-[1808/2400]">
                    <img
                      src={image}
                      alt={
                        index === 0
                          ? "Avista villa exterior detail"
                          : "Avista architectural stair detail"
                      }
                      class="h-full w-full object-cover filter-[saturate(0.92)_contrast(1.02)]"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                </figure>
              ))
            }
          </div>
          <div
            class="mx-auto mt-12 flex max-w-[820px] flex-col items-center gap-10 text-center tablet:mt-16"
          >
            <p
              class="font-display italic text-[22px] font-light leading-[1.4] text-charcoal tablet:text-[26px]"
            >
              Avista is a small collection of three private villas in
              Sithonia, Halkidiki — set between the pines of the peninsula and
              the clearest water in the Aegean. One contemporary stone
              flagship, two warmer sister villas. Each house has its own
              character.
              <br /><br />
              All three share the same promise: a quiet week, a beautiful garden,
              and the kind of privacy that lets a family actually be on holiday.
              We look after the houses ourselves, because that is how they stay
              this way.
            </p>
            <a href="#stay" class={buttonDark}>The Collection</a>
          </div>
        </div>
      </section>

      <section id="stay" class={`${section} bg-ink`}>
        <div class={`${container}`}>
          <div class="grid overflow-hidden tablet:grid-cols-2">
            <div
              class="flex min-h-[520px] flex-col items-center justify-center px-6 py-20 text-center tablet:min-h-[720px] tablet:px-12 desktop:px-20"
            >
              <p class={label}>The Collection</p>
              <h2
                class={`${heading} mt-8`}
                style="font-size: clamp(3.5rem, 7vw, 6.5rem);"
              >
                One flagship,
                <em class="font-light italic text-stone">two sisters.</em>
              </h2>
              <p
                class="mt-10 max-w-[560px] font-display italic text-[22px] font-light leading-[1.4] text-cream/80 tablet:text-[26px]"
              >
                Three villas in two architectural styles. The Avista Private
                Resort is our contemporary stone flagship. The Avista Villa and
                the Avista Superb Villa are sister properties — same warm Greek
                architecture, one with a pool, one without.
              </p>
              <a href="#contact" class={`${button} mt-10`}>Ask about dates</a>
            </div>
            <figure
              class="min-h-[420px] overflow-hidden tablet:min-h-[720px] object-cover"
            >
              <img
                src={stayImage}
                alt="Avista villa architectural detail"
                class="h-full w-full object-cover filter-[saturate(0.92)_contrast(1.02)]"
                loading="lazy"
                decoding="async"
              />
            </figure>
          </div>
          <div class="mt-5 grid gap-5 tablet:grid-cols-3">
            {
              rooms.map((room, index) => (
                <a href={room.href} class="group block overflow-hidden">
                  <div class="aspect-[4/5] overflow-hidden">
                    <img
                      src={room.image}
                      alt={room.name}
                      class="h-full w-full object-cover filter-[saturate(0.92)_contrast(1.02)] transition duration-700 group-hover:scale-105"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <p class="mt-5 font-display italic text-[14px] font-light tracking-[0.05em] text-stone">
                    {`№ ${String(index + 1).padStart(2, "0")} · ${room.meta}`}
                  </p>
                  <h3 class="mt-2 font-display text-[32px] font-light leading-[0.95] text-cream tablet:text-[44px]">
                    {room.name}
                  </h3>
                  <p class="mt-4 max-w-[420px] font-display text-[18px] font-light leading-[1.4] text-cream/70">
                    {room.description}
                  </p>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section id="sithonia" class={`${section} bg-charcoal`}>
        <div class={`${container}`}>
          <div
            class="flex flex-col items-start gap-8 tablet:flex-row tablet:items-end tablet:justify-between"
          >
            <div>
              <p class={label}>Why Sithonia</p>
              <h2
                class={`${heading} mt-5 max-w-[820px]`}
                style="font-size: clamp(2.75rem, 5.5vw, 4.75rem);"
              >
                The quieter middle leg
                <em class="font-light italic text-stone">of Halkidiki.</em>
              </h2>
            </div>
            <p
              class="max-w-[460px] font-display italic text-[20px] font-light leading-[1.45] text-cream/80 tablet:text-[22px]"
            >
              Forested, unhurried, closer to how Greece felt twenty years ago
              than how it looks on Instagram today. The water is the clearest
              in the country. The beaches are mostly empty.
            </p>
          </div>

          <div class="mt-12 grid gap-5 tablet:mt-16 tablet:grid-cols-3">
            {
              sithoniaCards.map((card) => (
                <article class="group">
                  <a href="#stories" class="block overflow-hidden">
                    <div class="aspect-[4/5]">
                      <img
                        src={card.image}
                        alt={card.title}
                        class="h-full w-full object-cover filter-[saturate(0.92)_contrast(1.02)] transition duration-700 group-hover:scale-105"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  </a>
                  <p class="mt-5 font-sans text-[10px] uppercase tracking-[0.3em] text-stone">
                    {card.eyebrow}
                  </p>
                  <h3 class="mt-3 font-display text-[28px] font-light leading-[1.05] text-cream tablet:text-[34px]">
                    {card.title}
                  </h3>
                  <p class="mt-3 max-w-[380px] font-display italic text-[18px] font-light leading-[1.45] text-cream/70">
                    {card.note}
                  </p>
                </article>
              ))
            }
          </div>

          <div class="mt-14 flex justify-center">
            <a href="#stories" class={button}>Read the Sithonia Guide</a>
          </div>
        </div>
      </section>

      <section id="hospitality" class={`${section} bg-cream text-charcoal`}>
        <div
          class={`${container} grid gap-10 tablet:grid-cols-[0.86fr_1.14fr] tablet:items-end`}
        >
          <div class="tablet:pb-8">
            <p class={labelDark}>The promise</p>
            <h2
              class={`${headingDark} mt-5 italic`}
              style="font-size: clamp(2.5rem, 5vw, 3.625rem);"
            >
              <span class="text-stone-deep">Beautifully</span> looked after.
            </h2>
            <p
              class="mt-8 font-display italic text-[22px] font-light leading-[1.4] text-charcoal/80 tablet:text-[26px]"
            >
              We hand guests keys, a hand-drawn map of Sithonia, and a phone
              number that actually answers. The rest of the week belongs to
              them. Privacy is the deliverable. Hospitality is the foundation
              underneath it.
            </p>
            <a href="#contact" class={`${buttonDark} mt-10`}>Reach out</a>
          </div>
          <figure class="overflow-hidden">
            <div class="aspect-[4/5]">
              <img
                src={garden02}
                alt="Quiet Avista villa garden detail"
                class="h-full w-full object-cover filter-[saturate(0.92)_contrast(1.02)]"
                loading="lazy"
                decoding="async"
              />
            </div>
          </figure>
        </div>
      </section>

      <section id="gallery" class={`${section} bg-ink`}>
        <div class={`${container}`}>
          <div
            class="flex flex-col gap-8 tablet:flex-row tablet:items-end tablet:justify-between"
          >
            <div class="text-center tablet:text-left">
              <p class={label}>The houses · in frame</p>
              <h2
                class={`${heading} mt-5`}
                style="font-size: clamp(2.5rem, 5vw, 3.625rem);"
              >
                A few
                <em class="font-light italic text-stone">quiet moments.</em>
              </h2>
            </div>
            <div class="flex justify-center gap-3 tablet:justify-end">
              <button
                type="button"
                class="embla__prev inline-flex h-14 w-14 items-center justify-center border border-stone/55 font-display text-[22px] font-medium leading-none text-cream transition hover:bg-stone hover:text-charcoal disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-transparent disabled:hover:text-cream"
                aria-label="Previous slide"
              >
                <svg
                  width="18"
                  height="14"
                  viewBox="0 0 18 14"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M7 1L1 7L7 13M1 7H17"
                    stroke="currentColor"
                    stroke-width="1.25"
                    stroke-linecap="square"></path>
                </svg>
              </button>
              <button
                type="button"
                class="embla__next inline-flex h-14 w-14 items-center justify-center border border-stone/55 font-display text-[22px] font-medium leading-none text-cream transition hover:bg-stone hover:text-charcoal disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-transparent disabled:hover:text-cream"
                aria-label="Next slide"
              >
                <svg
                  width="18"
                  height="14"
                  viewBox="0 0 18 14"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M11 1L17 7L11 13M17 7H1"
                    stroke="currentColor"
                    stroke-width="1.25"
                    stroke-linecap="square"></path>
                </svg>
              </button>
            </div>
          </div>
          <div class="embla mt-12 tablet:mt-16">
            <div class="embla__viewport overflow-hidden">
              <div class="embla__container flex">
                {
                  galleryImages.map((image) => (
                    <div class="embla__slide min-w-0 flex-[0_0_80%] pr-3 tablet:flex-[0_0_42%] tablet:pr-5 desktop:flex-[0_0_30%]">
                      <figure class="overflow-hidden">
                        <div class="aspect-[3/4]">
                          <img
                            src={image}
                            alt="Avista visual detail from the villa collection"
                            class="h-full w-full object-cover filter-[saturate(0.92)_contrast(1.02)]"
                            loading="lazy"
                            decoding="async"
                          />
                        </div>
                      </figure>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="testimonials" class={`${section} bg-charcoal`}>
        <div class={`${container}`}>
          <div class="grid gap-10 tablet:grid-cols-[0.9fr_1.1fr]">
            <div>
              <p class={label}>Words from guests</p>
              <h2
                class={`${heading} mt-5`}
                style="font-size: clamp(2.5rem, 5vw, 3.625rem);"
              >
                What our
                <em class="font-light italic text-stone">families say.</em>
              </h2>
            </div>
            <div class="grid gap-5">
              {
                testimonials.map((item) => (
                  <figure class="border-t border-stone/30 py-7">
                    <blockquote class="font-display italic text-[22px] font-light leading-[1.35] text-cream tablet:text-[28px]">
                      &ldquo;{item.quote}&rdquo;
                    </blockquote>
                    <figcaption class="mt-8 grid gap-1">
                      <p class="font-display text-[18px] font-medium text-cream">
                        {item.name}
                      </p>
                      <p class="font-sans text-[10px] uppercase tracking-[0.25em] text-stone-deep">
                        {item.role}
                      </p>
                    </figcaption>
                  </figure>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section id="stories" class={`${section} bg-bone text-charcoal`}>
        <div class={`${container}`}>
          <div
            class="flex flex-col gap-10 tablet:flex-row tablet:items-end tablet:justify-between"
          >
            <div>
              <p class={labelDark}>The Sithonia Journal</p>
              <h2
                class={`${headingDark} mt-5`}
                style="font-size: clamp(2.5rem, 5vw, 3.625rem);"
              >
                Notes from
                <em class="font-light italic text-stone-deep">the peninsula.</em>
              </h2>
            </div>
            <a href="#contact" class={buttonDark}>Ask for the map</a>
          </div>
          <div class="mt-12 grid gap-5 tablet:mt-16 tablet:grid-cols-3">
            {
              stories.map((story, index) => (
                <article class="group">
                  <a href="#stories" class="block overflow-hidden">
                    <div class="aspect-[4/5]">
                      <img
                        src={story.image}
                        alt={story.title}
                        class="h-full w-full object-cover filter-[saturate(0.92)_contrast(1.02)] transition duration-700 group-hover:scale-105"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  </a>
                  <p class="mt-5 font-sans text-[10px] uppercase tracking-[0.3em] text-stone-deep">
                    {`№ ${String(index + 1).padStart(2, "0")} · ${story.date}`}
                  </p>
                  <h3 class="mt-3 font-display text-[28px] font-light leading-[1.05] text-ink tablet:text-[36px]">
                    {story.title}
                  </h3>
                  <p class="mt-3 max-w-[420px] font-display italic text-[18px] font-light leading-[1.45] text-charcoal/70">
                    {story.excerpt}
                  </p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section
        id="book"
        class="relative overflow-hidden bg-charcoal px-3 pt-24 tablet:px-5 tablet:pt-32"
      >
        <img
          src={ctaImage}
          alt="Avista villa exterior atmosphere"
          class="absolute inset-0 h-full w-full object-cover filter-[saturate(0.92)_contrast(1.02)]"
          loading="lazy"
          decoding="async"
        />
        <div class="noise-layer"></div>
        <div
          class="absolute inset-0 bg-linear-to-b from-charcoal/65 via-charcoal/45 to-ink/75"
        >
        </div>
        <div class="cover-glow"></div>
        <div
          class={`${container} relative flex min-h-[520px] flex-col items-center justify-center text-center`}
        >
          <p
            class="font-sans text-[11px] font-medium uppercase tracking-[0.4em] text-stone"
          >
            Sithonia · Halkidiki · Greece
          </p>
          <span class="my-6 inline-block h-px w-12 bg-stone" aria-hidden="true"
          ></span>
          <h2
            class={`${headingHero} max-w-[920px] script-mark`}
            style="font-size: clamp(4.5rem, 11vw, 8.5rem);"
          >
            Plan a quiet week.
          </h2>
          <div class="mt-10 flex flex-wrap justify-center gap-3">
            <a
              href="#contact"
              class="inline-flex items-center justify-center bg-stone px-7 py-4 font-display text-[18px] font-normal italic leading-none text-charcoal transition hover:bg-cream"
              >Reach out</a
            >
            <a href="#stay" class={button}>See the houses</a>
          </div>
        </div>

        <footer
          id="contact"
          class={`${container} relative z-10 -mb-8 mt-4 bg-pine px-6 py-10 tablet:-mb-16 tablet:px-12 tablet:py-14 desktop:px-16 desktop:py-16`}
        >
          <div
            class="grid min-h-[360px] gap-12 border-b border-stone/30 pb-14 tablet:grid-cols-[1.2fr_0.8fr_0.8fr] desktop:grid-cols-[1.5fr_0.7fr_0.7fr_0.8fr]"
          >
            <div>
              <a
                href="#hero"
