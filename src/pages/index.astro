---
import '../styles/global.css';

const img = (id: string, w = 1800) => `https://framerusercontent.com/images/${id}?width=${w}`;

const heroImage = img('CuqtmnTZ5R7MUFjqqKLzxOuE.jpg', 2400);
const aboutImages = [
	img('3A53BTeppyXv4kXscSfBwXGHCs.png', 1200),
	img('7dMnmPMkcRWqcYHo12Ex4K7LQY.png', 1200)
];
const stayImage = img('50whmDPJYVop5IsjERI8QByTjY.png', 1800);
const diningImage = img('nzg8fDr0hzhA23MQmZDwgsEPpaU.jpg', 1800);
const meetingsImage = img('5baqDWM1vBNHKw7HCNQPGO3PFTw.jpg', 1800);
const weddingImage = img('W2eeIoIC1arHmMobKSPU8jAwVY.jpg', 1800);
const ctaImage = img('y2z8SWTM9KYApISpwHugI0C9TU.jpg', 2200);

const rooms = [
	{
		name: 'The Private Resort',
		meta: 'Sithonia · Built 2018',
		description: 'Contemporary stone in a private clearing, with a long pergola, a quiet pool, and the distant blue of the Aegean.',
		image: img('irpzvput8T6wavQdmcsbXA48hjw.jpg', 1400)
	},
	{
		name: 'The Garden Residence',
		meta: 'Sithonia · Reimagined 2020',
		description: 'A warmer Greek family home, full of bougainvillea, terracotta floors, wicker, dark wood, and slow mornings.',
		image: img('y2z8SWTM9KYApISpwHugI0C9TU.jpg', 1400)
	},
	{
		name: 'The Cypress House',
		meta: 'Sithonia · Built 2022',
		description: 'A design-led house with a sleek pool wrapped in olive trees and tall cypresses, lit gently for late evenings.',
		image: img('5baqDWM1vBNHKw7HCNQPGO3PFTw.jpg', 1400)
	}
];

const galleryImages = [
	img('4uOQia123xeqJfdROTJTqKfWRY.png', 1000),
	img('8OhuFkwTCPBRfT6plkJhhgwABhE.png', 1000),
	img('BW2Cdt3l5sECIrkpKvKcNvQmo.png', 1000),
	img('JeUardsWFKcGPQkToDuoE0pGnAg.png', 1000),
	img('l9s5F3L2zNEvaovDZKIlOxdfefc.png', 1000),
	img('gH4tZo5HIfRgI0xXhAK2kL6JLp0.png', 1000)
];

const testimonials = [
	{
		quote:
			'Avista felt private without feeling distant. The house was quiet, the garden was alive, and every local suggestion was exactly right.',
		name: 'Family from London',
		role: 'The Garden Residence'
	},
	{
		quote:
			'We spent the mornings under the pines and the evenings by the pool. Nothing felt rushed. That was the whole point.',
		name: 'Couple from Athens',
		role: 'The Cypress House'
	},
	{
		quote:
			'The house gave everyone room to be together and room to disappear for a while. Sithonia did the rest.',
		name: 'Family from Munich',
		role: 'The Private Resort'
	},
	{
		quote:
			'It felt family-run in the best way: personal when we needed something, invisible when we wanted the week to ourselves.',
		name: 'Friends from Thessaloniki',
		role: 'Avista Villas'
	}
];

const stories = [
	{
		title: 'A quiet week in Sithonia',
		date: 'Local notes',
		image: img('nkuTtv3wFdDvIX5xgimU7lY0I.png', 1000)
	},
	{
		title: 'The beaches we send friends to',
		date: 'Hand-drawn map',
		image: img('jkrN8mvDbY7UDlXBrst6vS3r2E.png', 1000)
	},
	{
		title: 'Dinner after the cicadas',
		date: 'Sithonia evenings',
		image: img('nzg8fDr0hzhA23MQmZDwgsEPpaU.jpg', 1000)
	}
];

const featureCards = [
	{
		image: diningImage,
		eyebrow: '/ The Land',
		title: 'Morning under the pines',
		alt: 'Quiet Avista garden detail'
	},
	{
		image: meetingsImage,
		eyebrow: '/ Local',
		title: 'The hour after sunset',
		alt: 'Avista evening atmosphere'
	}
];

const section = 'px-3 py-20 tablet:px-5 tablet:py-24 desktop:py-32';
const container = 'mx-auto w-full max-w-[1600px]';
const label = 'font-display text-sm font-normal tracking-normal text-cream/75 tablet:text-base';
const heading = 'font-display font-medium leading-[0.95] text-cream';
const headingHero = 'font-display font-medium leading-[0.85] text-cream';
const button =
	'inline-flex items-center justify-center border border-cream/35 px-6 py-4 font-display text-[18px] font-medium leading-none text-cream transition hover:bg-cream hover:text-charcoal';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Avista Villas is a small family collection of three private villas in the pines of Sithonia, Halkidiki. Quiet, private, and family-run."
		/>
		<meta name="theme-color" content="#2B2A27" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>Avista Villas - Three private villas in Sithonia</title>
	</head>
	<body class="bg-charcoal text-cream">
		<header class="fixed inset-x-0 top-0 z-50 px-3 pt-3 tablet:px-5 tablet:pt-5">
			<nav class="mx-auto flex max-w-[1600px] items-center justify-between" aria-label="Primary">
				<a
					href="#hero"
					class="font-display text-[24px] font-medium leading-[0.9] text-cream tablet:text-[28px]"
				>
					Avista Villas
				</a>
				<div class="flex items-center bg-cream p-1.5">
					<a
						href="#contact"
						class="hidden px-7 py-4 font-display text-[18px] font-medium leading-none text-ink tablet:block"
					>
						Reach out
					</a>
					<a
						href="#contact"
						aria-label="Open menu"
						class="relative flex h-12 w-12 items-center justify-center bg-charcoal tablet:h-14 tablet:w-14"
					>
						<span class="absolute h-px w-5 -translate-y-1.5 bg-cream"></span>
						<span class="absolute h-px w-5 translate-y-1.5 bg-cream"></span>
					</a>
				</div>
			</nav>
		</header>

		<main class="overflow-hidden">
			<section id="hero" class="relative min-h-screen bg-charcoal">
				<img
					src={heroImage}
					alt="Stone villa atmosphere with warm natural light"
					class="absolute inset-0 h-full w-full scale-105 object-cover"
					loading="eager"
					decoding="async"
				/>
				<div class="noise-layer"></div>
				<div class="absolute inset-0 bg-charcoal/35"></div>
				<div class="absolute inset-x-3 bottom-0 top-0 border-x border-cream/25 tablet:inset-x-5 desktop:left-[calc((100vw-1600px)/2)] desktop:right-[calc((100vw-1600px)/2)]">
					<div class="hidden h-full border-x border-cream/20 desktop:mx-[33.33%] desktop:block"></div>
				</div>
				<div class={`${container} relative flex min-h-screen flex-col items-center justify-center px-6 text-center`}>
					<h1
						class={headingHero}
						style="font-size: clamp(3.625rem, 10vw, 7.5rem);"
					>
						Avista<br />Villas
					</h1>
					<p class="mt-8 max-w-[520px] text-center font-display text-base font-normal leading-[1.4] text-cream tablet:text-lg">
						Three quiet houses in the pines, kept for families who want Greece on their own terms.
					</p>
					<a href="#about" class="absolute bottom-8 left-1/2 flex -translate-x-1/2 flex-col items-center gap-4 font-display text-sm font-normal text-cream">
						Scroll down
						<span class="h-24 w-px bg-cream"></span>
					</a>
				</div>
			</section>

			<section id="about" class={`${section} bg-charcoal`}>
				<div class={`${container}`}>
					<div class="flex flex-col items-center gap-6 text-center">
						<p class={`${label} text-center`}>/ About</p>
						<h2 class={heading} style="font-size: clamp(2.5rem, 5vw, 3.625rem);">
							A small family collection
						</h2>
					</div>
					<div class="mt-12 grid grid-cols-2 gap-3 tablet:mt-16 tablet:gap-5">
						{
							aboutImages.map((image, index) => (
								<figure class="overflow-hidden">
									<div class="aspect-[1808/2400]">
										<img
											src={image}
											alt={index === 0 ? 'Avista villa exterior detail' : 'Avista architectural stair detail'}
											class="h-full w-full object-cover"
											loading="lazy"
											decoding="async"
										/>
									</div>
								</figure>
							))
						}
					</div>
					<div class="mx-auto mt-12 flex max-w-[820px] flex-col items-center gap-10 text-center tablet:mt-16">
						<p class="font-display text-[22px] font-normal leading-[1.1] text-cream/55 tablet:text-[28px]">
							Avista is a small family collection of three private villas in Sithonia, Halkidiki, set between the pines of the peninsula and the clearest water in the Aegean. Each house has its own character.
							<br /><br />
							All three share the same promise: a quiet week, a beautiful garden, and the kind of privacy that lets a family actually be on holiday.
						</p>
						<a href="#stay" class={button}>The Collection</a>
					</div>
				</div>
			</section>

			<section id="stay" class={`${section} bg-ink`}>
				<div class={`${container}`}>
					<div class="grid gap-10 tablet:grid-cols-[1fr_0.8fr] tablet:items-end">
						<div>
							<p class={label}>/ The Collection</p>
							<h2 class={`${heading} mt-5`} style="font-size: clamp(2.5rem, 5vw, 3.625rem);">
								Three houses in Sithonia
							</h2>
						</div>
						<div class="flex flex-col gap-8 tablet:items-start">
							<p class="font-display text-[22px] font-normal leading-[1.1] text-cream/75 tablet:text-[28px]">
								Each Avista villa has its own architectural mood. One collection. Three distinct ways to spend a week.
							</p>
							<a href="#contact" class={button}>Ask about dates</a>
						</div>
					</div>
					<figure class="mt-12 overflow-hidden tablet:mt-16">
						<div class="aspect-[16/7] min-h-[330px]">
							<img src={stayImage} alt="Avista villa architectural detail" class="h-full w-full object-cover" loading="lazy" decoding="async" />
						</div>
					</figure>
					<div class="mt-5 grid gap-5 tablet:grid-cols-3">
						{
							rooms.map((room) => (
								<a href="#stay" class="group block overflow-hidden">
									<div class="aspect-[4/5] overflow-hidden">
										<img
											src={room.image}
											alt={room.name}
											class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
											loading="lazy"
											decoding="async"
										/>
									</div>
									<p class="mt-5 font-display text-[14px] font-normal text-cream/60">{room.meta}</p>
									<h3 class="mt-2 font-display text-[32px] font-medium leading-[0.95] text-cream tablet:text-[46px]">
										{room.name}
									</h3>
									<p class="mt-4 max-w-[420px] font-display text-[18px] font-normal leading-[1.25] text-cream/65">{room.description}</p>
								</a>
							))
						}
					</div>
				</div>
			</section>

			<section id="dining" class="grid bg-charcoal tablet:grid-cols-2">
				{
					featureCards.map((card) => (
						<article class="relative min-h-[620px] overflow-hidden border-t border-cream/20 tablet:border-r">
							<img
								src={card.image}
								alt={card.alt}
								class="absolute inset-0 h-full w-full object-cover"
								loading="lazy"
								decoding="async"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-charcoal/75 via-charcoal/20 to-transparent"></div>
							<div class="relative flex min-h-[620px] flex-col items-start justify-end p-5 tablet:p-10 desktop:p-16">
								<p class={label}>{card.eyebrow}</p>
								<h2 class={`${heading} mt-5`} style="font-size: clamp(2.5rem, 5vw, 3.625rem);">
									{card.title}
								</h2>
								<a href="#dining" class={`${button} mt-10`}>
									See the land
								</a>
							</div>
						</article>
					))
				}
			</section>

			<section id="weddings" class={`${section} bg-charcoal`}>
				<div class={`${container} grid gap-10 tablet:grid-cols-[0.86fr_1.14fr] tablet:items-end`}>
					<div class="tablet:pb-8">
						<p class={label}>/ The feeling</p>
						<h2 class={`${heading} mt-5 italic`} style="font-size: clamp(2.5rem, 5vw, 3.625rem);">
							Beautifully left alone.
						</h2>
						<p class="mt-8 font-display text-[22px] font-normal leading-[1.1] text-cream/75 tablet:text-[28px]">
							We look after the houses ourselves, because that is how they stay this quiet. Personal when you need us. Unhurried when you do not.
						</p>
						<a href="#contact" class={`${button} mt-10`}>Get in touch</a>
					</div>
					<figure class="overflow-hidden">
						<div class="aspect-[4/5]">
							<img src={weddingImage} alt="Quiet Avista villa detail" class="h-full w-full object-cover" loading="lazy" decoding="async" />
						</div>
					</figure>
				</div>
			</section>

			<section id="gallery" class={`${section} bg-ink`}>
				<div class={`${container}`}>
					<div class="text-center">
						<p class={label}>/ The Land</p>
						<h2 class={`${heading} mt-5`} style="font-size: clamp(2.5rem, 5vw, 3.625rem);">
							Morning, stone, olive leaf
						</h2>
					</div>
					<div class="mt-12 grid grid-cols-2 gap-3 tablet:mt-16 tablet:grid-cols-6 tablet:gap-5">
						{
							galleryImages.map((image, index) => (
								<figure class={`overflow-hidden ${index === 0 || index === 5 ? 'tablet:col-span-2' : 'tablet:col-span-1'}`}>
									<div class={index === 0 || index === 5 ? 'aspect-[4/5]' : 'aspect-[3/4]'}>
										<img src={image} alt="Avista visual detail from the villa collection" class="h-full w-full object-cover" loading="lazy" decoding="async" />
									</div>
								</figure>
							))
						}
					</div>
				</div>
			</section>

			<section id="testimonials" class={`${section} bg-charcoal`}>
				<div class={`${container}`}>
					<div class="grid gap-10 tablet:grid-cols-[0.9fr_1.1fr]">
						<div>
							<p class={label}>/ Notes</p>
							<h2 class={`${heading} mt-5`} style="font-size: clamp(2.5rem, 5vw, 3.625rem);">
								From people who stayed
							</h2>
						</div>
						<div class="grid gap-5">
							{
								testimonials.map((item) => (
									<figure class="border-t border-cream/25 py-7">
										<blockquote class="font-display text-[22px] font-normal leading-[1.1] text-cream tablet:text-[28px]">
											{item.quote}
										</blockquote>
										<figcaption class="mt-8 grid gap-1">
											<p class="font-display text-[18px] font-medium text-cream">{item.name}</p>
											<p class="font-display text-[14px] font-normal text-cream/55">{item.role}</p>
										</figcaption>
									</figure>
								))
							}
						</div>
					</div>
				</div>
			</section>

			<section id="stories" class={`${section} bg-ink`}>
				<div class={`${container}`}>
					<div class="flex flex-col gap-10 tablet:flex-row tablet:items-end tablet:justify-between">
						<div>
							<p class={label}>/ Journal</p>
							<h2 class={`${heading} mt-5`} style="font-size: clamp(2.5rem, 5vw, 3.625rem);">
								Local notes from Sithonia
							</h2>
						</div>
						<a href="#contact" class={button}>Ask for the map</a>
					</div>
					<div class="mt-12 grid gap-5 tablet:mt-16 tablet:grid-cols-3">
						{
							stories.map((story) => (
								<article class="group">
									<a href="#stories" class="block overflow-hidden">
										<div class="aspect-[4/5]">
											<img
												src={story.image}
												alt={story.title}
												class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
												loading="lazy"
												decoding="async"
											/>
										</div>
									</a>
									<p class="mt-5 font-display text-[14px] font-normal text-cream/65">{story.date}</p>
									<h3 class="mt-3 font-display text-[32px] font-medium leading-[0.95] text-cream tablet:text-[46px]">
										{story.title}
									</h3>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section id="book" class="relative overflow-hidden bg-charcoal px-3 pt-24 tablet:px-5 tablet:pt-32">
				<img src={ctaImage} alt="Avista villa exterior atmosphere" class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" />
				<div class="noise-layer"></div>
				<div class="absolute inset-0 bg-charcoal/55"></div>
				<div class={`${container} relative flex min-h-[520px] flex-col items-center justify-center text-center`}>
					<p class="font-display text-[18px] font-medium text-cream">Sithonia · Halkidiki · Greece</p>
					<h2 class={`${headingHero} mt-6 max-w-[920px] italic`} style="font-size: clamp(3.625rem, 9vw, 7rem);">
						Plan a quiet week.
					</h2>
					<div class="mt-10 flex flex-wrap justify-center gap-3">
						<a href="#contact" class="bg-cream px-7 py-4 font-display text-[18px] font-medium leading-none text-ink">Reach out</a>
						<a href="#stay" class={button}>See the houses</a>
					</div>
				</div>

				<footer id="contact" class={`${container} relative z-10 -mb-8 mt-4 bg-cypress px-6 py-10 tablet:-mb-16 tablet:px-12 tablet:py-14 desktop:px-16 desktop:py-16`}>
					<div class="grid min-h-[360px] gap-12 border-b border-cream/25 pb-14 tablet:grid-cols-[1.2fr_0.8fr_0.8fr] desktop:grid-cols-[1.5fr_0.7fr_0.7fr_0.8fr]">
						<div>
							<a href="#hero" class="font-display text-[40px] font-medium leading-[0.9] text-cream tablet:text-[58px]">
								Avista Villas
							</a>
							<p class="mt-7 max-w-[360px] font-display text-[16px] font-normal leading-[1.4] text-cream/70">
								Avista Villas · Sithonia, Greece<br />
								40.1056° N, 23.8642° E
							</p>
							<div class="mt-7 grid gap-2 font-display text-[16px] font-normal text-cream/80">
								<a href="tel:+300000000000">+30 ___ ___ ____</a>
								<a href="mailto:hello@avistavillas.com">hello@avistavillas.com</a>
							</div>
						</div>
						<nav class="grid gap-4 content-start" aria-label="Sitemap">
							<p class={label}>/ Sitemap</p>
							<a href="#hero" class="footer-link">Home</a>
							<a href="#about" class="footer-link">About</a>
							<a href="#stay" class="footer-link">The Collection</a>
							<a href="#stories" class="footer-link">Stories</a>
							<a href="#contact" class="footer-link">Contact</a>
						</nav>
						<nav class="grid gap-4 content-start" aria-label="Villas">
							<p class={label}>/ Villas</p>
							<a href="#stay" class="footer-link">The Private Resort</a>
							<a href="#stay" class="footer-link">The Garden Residence</a>
							<a href="#stay" class="footer-link">The Cypress House</a>
						</nav>
						<nav class="flex flex-col gap-4 desktop:items-end" aria-label="Social">
							<a href="https://www.instagram.com/avistavillas/" target="_blank" rel="noopener" class="footer-link">Instagram</a>
							<a href="mailto:hello@avistavillas.com" class="footer-link">@avistavillas</a>
						</nav>
					</div>
					<div class="flex flex-col gap-7 pt-8 tablet:flex-row tablet:items-center tablet:justify-between">
						<div class="flex flex-wrap gap-x-8 gap-y-3 font-display text-[18px] font-medium text-cream">
							<a href="https://www.instagram.com/avistavillas/" target="_blank" rel="noopener">Instagram</a>
							<a href="mailto:hello@avistavillas.com">Email</a>
						</div>
						<p class="font-display text-[14px] font-normal text-cream/70">✺ Avista · © 2026 Avista Villas</p>
					</div>
				</footer>

				<div class={`${container} relative z-0 pt-16 pb-4 tablet:pt-24 desktop:pt-28`}>
					<p class="pointer-events-none select-none whitespace-nowrap font-sans text-[22vw] font-black uppercase leading-[0.72] text-cream/55 [mask-image:linear-gradient(180deg,#000,rgba(0,0,0,0.25))]">
						Avista Villas
					</p>
				</div>
			</section>
		</main>
	</body>
</html>
