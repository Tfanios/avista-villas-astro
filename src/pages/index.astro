---
import '../styles/global.css';

const img = (id: string, w = 1800) => `https://framerusercontent.com/images/${id}?width=${w}`;

const heroImage = img('CuqtmnTZ5R7MUFjqqKLzxOuE.jpg', 2400);
const aboutImages = [
	img('3A53BTeppyXv4kXscSfBwXGHCs.png', 1200),
	img('7dMnmPMkcRWqcYHo12Ex4K7LQY.png', 1200)
];
const stayImage = img('50whmDPJYVop5IsjERI8QByTjY.png', 1800);
const diningImage = img('nzg8fDr0hzhA23MQmZDwgsEPpaU.jpg', 1800);
const meetingsImage = img('5baqDWM1vBNHKw7HCNQPGO3PFTw.jpg', 1800);
const weddingImage = img('W2eeIoIC1arHmMobKSPU8jAwVY.jpg', 1800);
const ctaImage = img('y2z8SWTM9KYApISpwHugI0C9TU.jpg', 2200);

const rooms = [
	{
		name: 'Bellavista Essential',
		image: img('irpzvput8T6wavQdmcsbXA48hjw.jpg', 1400)
	},
	{
		name: 'Bellavista Signature',
		image: img('y2z8SWTM9KYApISpwHugI0C9TU.jpg', 1400)
	},
	{
		name: 'Bellavista Premier',
		image: img('5baqDWM1vBNHKw7HCNQPGO3PFTw.jpg', 1400)
	}
];

const galleryImages = [
	img('4uOQia123xeqJfdROTJTqKfWRY.png', 1000),
	img('8OhuFkwTCPBRfT6plkJhhgwABhE.png', 1000),
	img('BW2Cdt3l5sECIrkpKvKcNvQmo.png', 1000),
	img('JeUardsWFKcGPQkToDuoE0pGnAg.png', 1000),
	img('l9s5F3L2zNEvaovDZKIlOxdfefc.png', 1000),
	img('gH4tZo5HIfRgI0xXhAK2kL6JLp0.png', 1000)
];

const testimonials = [
	{
		quote:
			'Bellavista felt calm, thoughtful, and beautifully designed. Every detail just made sense, from the room to the service. Easily one of the best stays I’ve had.',
		name: 'Sarah Mitchell',
		role: 'Creative Director at Studio North'
	},
	{
		quote:
			'The balance between comfort and elegance is spot on. It’s the kind of place you want to come back to after a long day and truly unwind.',
		name: 'Daniel Roberts',
		role: 'Operations Manager at UrbanWorks'
	},
	{
		quote:
			'We hosted meetings here and stayed overnight - the experience was seamless. Great spaces, attentive staff, and a peaceful atmosphere.',
		name: 'Ayesha Khan',
		role: 'Project Lead at Horizon Consulting'
	},
	{
		quote:
			'From check-in to checkout, everything felt effortless. Bellavista doesn’t just offer rooms, it offers an experience.',
		name: 'James Carter',
		role: 'Founder at Brightline Co.'
	}
];

const stories = [
	{
		title: 'A Different Kind of Escape',
		date: 'December 26, 2025',
		image: img('nkuTtv3wFdDvIX5xgimU7lY0I.png', 1000)
	},
	{
		title: 'Moments Between Check-In and Goodbye',
		date: 'December 26, 2025',
		image: img('jkrN8mvDbY7UDlXBrst6vS3r2E.png', 1000)
	},
	{
		title: 'The Art of Slowing Down',
		date: 'December 26, 2025',
		image: img('nzg8fDr0hzhA23MQmZDwgsEPpaU.jpg', 1000)
	}
];

const featureCards = [
	{
		image: diningImage,
		eyebrow: '/ Dining',
		title: 'Taste the Stay',
		alt: 'Bellavista dining'
	},
	{
		image: meetingsImage,
		eyebrow: '/ Meetings',
		title: 'Work With a View',
		alt: 'Bellavista meetings'
	}
];

const section = 'px-3 py-20 tablet:px-5 tablet:py-24 desktop:py-32';
const container = 'mx-auto w-full max-w-[1600px]';
const label = 'font-display text-sm font-normal uppercase tracking-normal text-cream/75 tablet:text-base';
const heading = 'font-display font-medium leading-[0.9] tracking-[-0.04em] text-cream';
const headingHero = 'font-display font-medium leading-[0.8] tracking-[-0.06em] text-cream';
const button =
	'inline-flex items-center justify-center border border-cream/35 px-6 py-4 font-display text-[18px] font-medium uppercase leading-none text-cream transition hover:bg-cream hover:text-charcoal';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Bellavista is where beautiful places meet effortless stays. Discover refined accommodations, dining, meetings, weddings, stories, and gallery moments."
		/>
		<meta name="theme-color" content="#023b2d" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>Bellavista - Refined Stays</title>
	</head>
	<body class="bg-charcoal text-cream">
		<header class="fixed inset-x-0 top-0 z-50 px-3 pt-3 tablet:px-5 tablet:pt-5">
			<nav class="mx-auto flex max-w-[1600px] items-center justify-between" aria-label="Primary">
				<a
					href="#hero"
					class="font-display text-[24px] font-medium uppercase leading-[0.9] tracking-[-0.04em] text-cream tablet:text-[28px]"
				>
					Bellavista
				</a>
				<div class="flex items-center bg-cream p-1.5">
					<a
						href="#stay"
						class="hidden px-7 py-4 font-display text-[18px] font-medium uppercase leading-none text-ink tablet:block"
					>
						Book Now
					</a>
					<a
						href="#contact"
						aria-label="Open menu"
						class="relative flex h-12 w-12 items-center justify-center bg-charcoal tablet:h-14 tablet:w-14"
					>
						<span class="absolute h-px w-5 -translate-y-1.5 bg-cream"></span>
						<span class="absolute h-px w-5 translate-y-1.5 bg-cream"></span>
					</a>
				</div>
			</nav>
		</header>

		<main class="overflow-hidden">
			<section id="hero" class="relative min-h-screen bg-charcoal">
				<img
					src={heroImage}
					alt="Aesthetic motion blur architect"
					class="absolute inset-0 h-full w-full scale-105 object-cover"
					loading="eager"
					decoding="async"
				/>
				<div class="noise-layer"></div>
				<div class="absolute inset-0 bg-charcoal/35"></div>
				<div class="absolute inset-x-3 bottom-0 top-0 border-x border-cream/25 tablet:inset-x-5 desktop:left-[calc((100vw-1600px)/2)] desktop:right-[calc((100vw-1600px)/2)]">
					<div class="hidden h-full border-x border-cream/20 desktop:mx-[33.33%] desktop:block"></div>
				</div>
				<div class={`${container} relative flex min-h-screen flex-col items-center justify-center px-6 text-center`}>
					<h1
						class={`${headingHero} uppercase`}
						style="font-size: clamp(3.625rem, 10vw, 7.5rem);"
					>
						Discover<br />Bellavista
					</h1>
					<p class="mt-8 max-w-[520px] text-center font-display text-base font-normal leading-[1.4] text-cream tablet:text-lg">
						Where flavor becomes art and every moment feels curated. Indulge in a world of refined tastes crafted in the center of europe
					</p>
					<a href="#about" class="absolute bottom-8 left-1/2 flex -translate-x-1/2 flex-col items-center gap-4 font-display text-sm font-normal uppercase tracking-normal text-cream">
						Scroll Down
						<span class="h-24 w-px bg-cream"></span>
					</a>
				</div>
			</section>

			<section id="about" class={`${section} bg-charcoal`}>
				<div class={`${container}`}>
					<div class="flex flex-col items-center gap-6 text-center">
						<p class={`${label} text-center`}>/ About</p>
						<h2 class={`${heading} uppercase`} style="font-size: clamp(2.5rem, 5vw, 3.625rem);">
							Beauty<br />in Every Stay
						</h2>
					</div>
					<div class="mt-12 grid grid-cols-2 gap-3 tablet:mt-16 tablet:gap-5">
						{
							aboutImages.map((image, index) => (
								<figure class="overflow-hidden">
									<div class="aspect-[1808/2400]">
										<img
											src={image}
											alt={index === 0 ? 'Bellavista drown view' : 'Bellavista stairs'}
											class="h-full w-full object-cover"
											loading="lazy"
											decoding="async"
										/>
									</div>
								</figure>
							))
						}
					</div>
					<div class="mx-auto mt-12 flex max-w-[820px] flex-col items-center gap-10 text-center tablet:mt-16">
						<p class="font-display text-[22px] font-normal leading-[1.1] tracking-[-0.02em] text-cream/55 tablet:text-[28px]">
							BELLAVISTA is where beautiful places meet effortless stays. We curate exceptional accommodations that blend comfort, design, and location, so every stay feels thoughtfully chosen. Whether you’re traveling for relaxation, work, or adventure, BELLAVISTA helps you discover spaces that elevate your journey.
							<br /><br />
							We believe a great stay sets the tone for the entire experience. That’s why BELLAVISTA focuses on quality, transparency, and ease - from browsing to booking. With handpicked listings and a seamless platform, we make it simple to find stays you’ll love and return to, wherever life takes you.
						</p>
						<a href="#about" class={button}>About Us</a>
					</div>
				</div>
			</section>

			<section id="stay" class={`${section} bg-ink`}>
				<div class={`${container}`}>
					<div class="grid gap-10 tablet:grid-cols-[1fr_0.8fr] tablet:items-end">
						<div>
							<p class={label}>/ Stay</p>
							<h2 class={`${heading} mt-5 uppercase`} style="font-size: clamp(2.5rem, 5vw, 3.625rem);">
								Your Kind of Stay
							</h2>
						</div>
						<div class="flex flex-col gap-8 tablet:items-start">
							<p class="font-display text-[22px] font-normal leading-[1.1] tracking-[-0.02em] text-cream/75 tablet:text-[28px]">
								From peaceful escapes to city favorites, we focus on comfort, character, and the little details that make a place worth the night.
							</p>
							<a href="#stay" class={button}>View All Rooms</a>
						</div>
					</div>
					<figure class="mt-12 overflow-hidden tablet:mt-16">
						<div class="aspect-[16/7] min-h-[330px]">
							<img src={stayImage} alt="Architect pattern" class="h-full w-full object-cover" loading="lazy" decoding="async" />
						</div>
					</figure>
					<div class="mt-5 grid gap-5 tablet:grid-cols-3">
						{
							rooms.map((room) => (
								<a href="#stay" class="group block overflow-hidden">
									<div class="aspect-[4/5] overflow-hidden">
										<img
											src={room.image}
											alt={room.name}
											class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
											loading="lazy"
											decoding="async"
										/>
									</div>
									<h3 class="mt-5 font-display text-[32px] font-medium uppercase leading-[0.9] tracking-[-0.04em] text-cream tablet:text-[46px]">
										{room.name}
									</h3>
								</a>
							))
						}
					</div>
				</div>
			</section>

			<section id="dining" class="grid bg-charcoal tablet:grid-cols-2">
				{
					featureCards.map((card) => (
						<article class="relative min-h-[620px] overflow-hidden border-t border-cream/20 tablet:border-r">
							<img
								src={card.image}
								alt={card.alt}
								class="absolute inset-0 h-full w-full object-cover"
								loading="lazy"
								decoding="async"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-charcoal/75 via-charcoal/20 to-transparent"></div>
							<div class="relative flex min-h-[620px] flex-col items-start justify-end p-5 tablet:p-10 desktop:p-16">
								<p class={label}>{card.eyebrow}</p>
								<h2 class={`${heading} mt-5 uppercase`} style="font-size: clamp(2.5rem, 5vw, 3.625rem);">
									{card.title}
								</h2>
								<a href="#dining" class={`${button} mt-10`}>
									Explore More
								</a>
							</div>
						</article>
					))
				}
			</section>

			<section id="weddings" class={`${section} bg-charcoal`}>
				<div class={`${container} grid gap-10 tablet:grid-cols-[0.86fr_1.14fr] tablet:items-end`}>
					<div class="tablet:pb-8">
						<p class={label}>/ Weddings</p>
						<h2 class={`${heading} mt-5 uppercase`} style="font-size: clamp(2.5rem, 5vw, 3.625rem);">
							Begin With Beauty
						</h2>
						<p class="mt-8 font-display text-[22px] font-normal leading-[1.1] tracking-[-0.02em] text-cream/75 tablet:text-[28px]">
							Weddings at BELLAVISTA are designed to feel personal, beautiful, and unforgettable. From intimate ceremonies to grand celebrations, every detail is shaped around your story
						</p>
						<a href="#weddings" class={`${button} mt-10`}>Explore More</a>
					</div>
					<figure class="overflow-hidden">
						<div class="aspect-[4/5]">
							<img src={weddingImage} alt="Bellavista Architect" class="h-full w-full object-cover" loading="lazy" decoding="async" />
						</div>
					</figure>
				</div>
			</section>

			<section id="gallery" class={`${section} bg-ink`}>
				<div class={`${container}`}>
					<div class="text-center">
						<p class={label}>/ Gallery</p>
						<h2 class={`${heading} mt-5 uppercase`} style="font-size: clamp(2.5rem, 5vw, 3.625rem);">
							A Closer Look
						</h2>
					</div>
					<div class="mt-12 grid grid-cols-2 gap-3 tablet:mt-16 tablet:grid-cols-6 tablet:gap-5">
						{
							galleryImages.map((image, index) => (
								<figure class={`overflow-hidden ${index === 0 || index === 5 ? 'tablet:col-span-2' : 'tablet:col-span-1'}`}>
									<div class={index === 0 || index === 5 ? 'aspect-[4/5]' : 'aspect-[3/4]'}>
										<img src={image} alt="Bellavista gallery" class="h-full w-full object-cover" loading="lazy" decoding="async" />
									</div>
								</figure>
							))
						}
					</div>
				</div>
			</section>

			<section id="testimonials" class={`${section} bg-charcoal`}>
				<div class={`${container}`}>
					<div class="grid gap-10 tablet:grid-cols-[0.9fr_1.1fr]">
						<div>
							<p class={label}>/ Testimonials</p>
							<h2 class={`${heading} mt-5 uppercase`} style="font-size: clamp(2.5rem, 5vw, 3.625rem);">
								Stories<br />From the Stay
							</h2>
						</div>
						<div class="grid gap-5">
							{
								testimonials.map((item) => (
									<figure class="border-t border-cream/25 py-7">
										<blockquote class="font-display text-[22px] font-normal leading-[1.1] tracking-[-0.02em] text-cream tablet:text-[28px]">
											{item.quote}
										</blockquote>
										<figcaption class="mt-8 grid gap-1">
											<p class="font-display text-[18px] font-medium text-cream">{item.name}</p>
											<p class="font-display text-[14px] font-normal text-cream/55">{item.role}</p>
										</figcaption>
									</figure>
								))
							}
						</div>
					</div>
				</div>
			</section>

			<section id="stories" class={`${section} bg-ink`}>
				<div class={`${container}`}>
					<div class="flex flex-col gap-10 tablet:flex-row tablet:items-end tablet:justify-between">
						<div>
							<p class={label}>/ Stories</p>
							<h2 class={`${heading} mt-5 uppercase`} style="font-size: clamp(2.5rem, 5vw, 3.625rem);">
								Moments &amp; Memories
							</h2>
						</div>
						<a href="#stories" class={button}>Explore More</a>
					</div>
					<div class="mt-12 grid gap-5 tablet:mt-16 tablet:grid-cols-3">
						{
							stories.map((story) => (
								<article class="group">
									<a href="#stories" class="block overflow-hidden">
										<div class="aspect-[4/5]">
											<img
												src={story.image}
												alt={story.title}
												class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
												loading="lazy"
												decoding="async"
											/>
										</div>
									</a>
									<p class="mt-5 font-display text-[14px] font-normal text-cream/65">{story.date}</p>
									<h3 class="mt-3 font-display text-[32px] font-medium uppercase leading-[0.9] tracking-[-0.04em] text-cream tablet:text-[46px]">
										{story.title}
									</h3>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<section id="book" class={`${section} relative min-h-[720px] bg-charcoal`}>
				<img src={ctaImage} alt="Bellavista aesthetic architect" class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" />
				<div class="noise-layer"></div>
				<div class="absolute inset-0 bg-charcoal/55"></div>
				<div class={`${container} relative flex min-h-[620px] flex-col items-center justify-center text-center`}>
					<p class="font-display text-[18px] font-medium text-cream">4.9 | 25K+ Reviews</p>
					<h2 class={`${headingHero} mt-6 max-w-[920px] uppercase`} style="font-size: clamp(3.625rem, 9vw, 7rem);">
						Your Next Stay Starts Here
					</h2>
					<div class="mt-10 flex flex-wrap justify-center gap-3">
						<a href="#stay" class="bg-cream px-7 py-4 font-display text-[18px] font-medium uppercase leading-none text-ink">Book Now</a>
						<a href="#contact" class={button}>Contact Us</a>
					</div>
				</div>
			</section>
		</main>

		<footer id="contact" class="relative bg-charcoal px-3 py-16 tablet:px-5 tablet:py-24">
			<div class={`${container}`}>
				<div class="grid gap-12 border-b border-cream/25 pb-14 tablet:grid-cols-[1.2fr_0.8fr_0.8fr] desktop:grid-cols-[1.5fr_0.7fr_0.7fr_0.8fr]">
					<div>
						<a href="#hero" class="font-display text-[40px] font-medium uppercase leading-[0.9] tracking-[-0.06em] text-cream tablet:text-[58px]">
							Bellavista
						</a>
						<p class="mt-7 max-w-[360px] font-display text-[16px] font-normal leading-[1.4] text-cream/70">
							123 Vista Boulevard, Palm Heights District, Downtown Marina Area,
						</p>
						<div class="mt-7 grid gap-2 font-display text-[16px] font-normal text-cream/80">
							<a href="tel:+000123456789">+00 0123456789</a>
							<a href="mailto:contact@bellavista.com">contact@bellavista.com</a>
						</div>
					</div>
					<nav class="grid gap-4" aria-label="Sitemap">
						<p class={label}>/ Sitemap</p>
						<a href="#hero" class="footer-link">Home</a>
						<a href="#about" class="footer-link">About</a>
						<a href="#stay" class="footer-link">Rooms</a>
						<a href="#stories" class="footer-link">Stories</a>
						<a href="#contact" class="footer-link">Contact</a>
					</nav>
					<nav class="grid gap-4" aria-label="Amenities">
						<p class={label}>/ Amenities</p>
						<a href="#dining" class="footer-link">Dinning</a>
						<a href="#dining" class="footer-link">Meetings</a>
						<a href="#weddings" class="footer-link">Weddings</a>
					</nav>
					<nav class="flex flex-col gap-4 desktop:items-end" aria-label="Social">
						<a href="https://x.com/basit_designs" target="_blank" rel="noopener" class="footer-link">Twitter(X)</a>
						<a href="https://www.instagram.com/basit.designs/" target="_blank" rel="noopener" class="footer-link">Instagram</a>
						<a href="https://www.linkedin.com/in/basitakhan/?originalSubdomain=sa" target="_blank" rel="noopener" class="footer-link">LinkedIn</a>
					</nav>
				</div>
				<div class="flex flex-col gap-7 pt-8 tablet:flex-row tablet:items-center tablet:justify-between">
					<p class="font-display text-[14px] font-normal text-cream/70">© 2025 All rights reserved.</p>
					<h2 class="pointer-events-none select-none font-display text-[21vw] font-medium uppercase leading-[0.75] tracking-[-0.07em] text-cream opacity-80 [mask-image:linear-gradient(180deg,#000,transparent)] tablet:text-[11vw]">
						Bellavista
					</h2>
				</div>
			</div>
		</footer>
	</body>
</html>
